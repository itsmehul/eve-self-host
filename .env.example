# OpenRouter (DeepSeek V4 Flash via @openrouter/ai-sdk-provider)
OPENROUTER_API_KEY=

# Optional: only needed if you switch back to a string AI Gateway model ID
# AI_GATEWAY_API_KEY=

# Postgres (pgvector) — workflow world + app DB
# Local compose uses service hostname `db`; override in production.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://eve:change-me@localhost:5432/eve
# Prefer explicit Workflow URL; falls back to DATABASE_URL if unset
WORKFLOW_POSTGRES_URL=postgresql://eve:change-me@localhost:5432/eve

# Route auth — eve HTTP channel (server)
ROUTE_AUTH_BASIC_USERNAME=eve
ROUTE_AUTH_BASIC_PASSWORD=change-me

# Same credentials for the Next.js Web Chat client (self-host Basic auth)
NEXT_PUBLIC_ROUTE_AUTH_BASIC_USERNAME=eve
NEXT_PUBLIC_ROUTE_AUTH_BASIC_PASSWORD=change-me

# Optional: separate eve origin when Next and eve are not co-located
# EVE_NEXT_PRODUCTION_ORIGIN=https://agent.example.com

# Optional: local production eve proxy port (default 4274)
# EVE_NEXT_PRODUCTION_PORT=4274
